# Copy this file to .env and fill in the real values.
# Supabase values: dashboard → Project Settings → API (Data API / API Keys).

# Public (sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret, server-only. Never give these a NEXT_PUBLIC_ name.
# Secret key (sb_secret_…) or legacy service_role key: bypasses RLS; the server writes student stats with it.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# For the chatbot.
OPENAI_API_KEY=your-openai-key
