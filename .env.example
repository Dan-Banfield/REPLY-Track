# Copy this file to .env and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project Settings → API (Data API / API Keys).
# The two NEXT_PUBLIC_ values are public (sent to the browser). Everything else is server-only:
# never give it a NEXT_PUBLIC_ name.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret key, used to upload students' files for teachers. Find it under Project Settings → API Keys:
# the service_role key (legacy) or a secret key (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# OpenAI key for the chatbot (features/chatbot). Server-only: never give it a NEXT_PUBLIC_ name.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key
