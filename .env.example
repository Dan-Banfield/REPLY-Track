# Copy this file to .env and fill in the real values.
# Supabase values: dashboard → Project Settings → API (Data API / API Keys).
# The two NEXT_PUBLIC_ values are public (sent to the browser). Everything else is server-only:
# never give it a NEXT_PUBLIC_ name.

# Public (sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret key (sb_secret_…) or legacy service_role key. Bypasses RLS: the server uses it to
# save student stats (student_stats) and upload students' files for teachers (student_files).
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# OpenAI key for the chatbot (features/chatbot). Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key
